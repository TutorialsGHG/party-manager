{
	"name": "party-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check:docs": "node scripts/check-docs.ts",
		"check:i18n": "node scripts/check-i18n.ts",
		"check:boundaries": "node scripts/check-boundaries.ts",
		"check:no-external": "node scripts/check-no-external.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:ci": "pnpm run check:docs && pnpm run check:i18n && pnpm run check:boundaries && pnpm run check:no-external && pnpm run lint && pnpm run check && pnpm run test:unit --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/better-sqlite3": "^7.6.13",
		"@types/nodemailer": "^7.0.10",
		"@types/qrcode": "^1.5.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.16.0",
		"@simplewebauthn/server": "^14.0.2",
		"argon2": "^0.45.1",
		"better-sqlite3": "^13.0.3",
		"blurhash": "^2.0.5",
		"nodemailer": "^10.0.10",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.4",
		"zod": "^4.6.5"
	}
}
