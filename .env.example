# Public URL used in invitation links and SvelteKit's same-origin form protection.
BASE_URL=http://localhost:3000

# Required before exposing the app outside a trusted local environment. Use a
# high-entropy secret and store it only in your deployment secret manager.
ENCRYPTION_PASSPHRASE=replace-with-a-long-random-secret

# Signs the registration proof-of-work challenges (HMAC-SHA256). Optional, but set
# it explicitly: without it the server generates a random secret on every boot, which
# invalidates all challenges issued before a restart and makes the behaviour differ
# per node when running more than one instance.
# Generate with: openssl rand -hex 32
POW_SECRET=
